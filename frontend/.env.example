# Supabase project — the same project the MCP server points at.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Shown on Settings → Connect your assistant.
#
# Only needed here in local development, where the API is a separate process on
# 8787. A deploy serves this app from the MCP server itself, and the app reads
# /mcp off its own origin — leave this unset there.
VITE_MCP_SERVER_URL=http://localhost:8787/mcp
