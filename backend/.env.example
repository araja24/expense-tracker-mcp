# The public origin this server is reachable at — an origin, no trailing path.
# It is the OAuth issuer and the MCP resource identifier, and every advertised
# endpoint is derived from it, so once deployed it must be the real external
# https URL. The server refuses to start on plaintext unless it is localhost.
PUBLIC_URL=http://localhost:8787

# Most hosts set PORT themselves; leave it unset there.
PORT=8787

# Supabase project. The ANON key only — every data read and write in this
# server runs as the end user under RLS. A service-role key is rejected at
# startup, because it would bypass RLS and see everyone's data.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# OAuth bookkeeping only (the mcp_oauth schema) — never expense data.
#
# Use the SESSION POOLER on port 5432, not db.<ref>.supabase.co: the direct
# host is IPv6-only and fails with ENOTFOUND on most networks. Connect as the
# restricted role from supabase/create_mcp_role.sql rather than `postgres`,
# keeping the username in the pooler's <role>.<project-ref> form. Percent-encode
# any special characters in the password.
DATABASE_URL=postgresql://mcp_oauth_rw.your-project-ref:password@aws-0-your-region.pooler.supabase.com:5432/postgres

# The web app, linked from the consent screen. In a deploy this server serves
# the app itself, so it defaults to PUBLIC_URL and should be left unset. Set it
# only for local work, where Vite serves the app on its own port.
APP_URL=http://localhost:5173

# Token lifetimes (seconds). Defaults: 1h access, 30d refresh, 5m auth code.
# ACCESS_TOKEN_TTL_SECONDS=3600
# REFRESH_TOKEN_TTL_SECONDS=2592000
# AUTH_CODE_TTL_SECONDS=300
